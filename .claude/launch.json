{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "service-visuals",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "app.py"
      ],
      "port": 8765
    },
    {
      "name": "service-visuals-dev",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": [
        "app.py"
      ],
      "env": {
        "PORT": "8799",
        "SERVICE_VISUALS_STATS": "0",
        "SERVICE_VISUALS_CONFIG": "/private/tmp/service-visuals-dev-config"
      },
      "port": 8799
    }
  ]
}